# Account/cart backend. Leave disabled until database migration, email, files and admin are ready.
COMMERCE_ENABLED=false
DATABASE_URL=
WEB_ORIGIN=https://routinepack.download
ADMIN_EMAIL=
# gmail_api sends through HTTPS and works on Railway plans with blocked outbound SMTP.
MAIL_PROVIDER=gmail_api
SMTP_FROM=Routine Pack <mukvik1@gmail.com>
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Alternative when outbound SMTP is supported on your Railway plan: MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mukvik1@gmail.com
SMTP_PASSWORD=
# Service account with read-only Drive access; single-line JSON kept only as an environment variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Map each product code to an array of private Drive files: [{"name":"Download ZIP","fileId":"..."}].
# Never put this configuration or a public Drive URL in frontend code.
COMMERCE_FILES_JSON=
# Optional: webhook confirmation remains OFF until monobank merchant activation and verified API integration.
MONOBANK_ENABLED=false
MONOBANK_TOKEN=

# Telegram owner bot is optional and never creates payments itself.
TELEGRAM_ENABLED=false
# Owner-provided bot URL: https://t.me/Routinepack_bot (getMe verified on activation).
TELEGRAM_BOT_USERNAME=Routinepack_bot
# Create through your own Telegram account with @BotFather; keep the token only on Railway.
TELEGRAM_BOT_TOKEN=
# Random 16-256 characters; Telegram sends this in the webhook header.
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user ID of the owner; the bot accepts only this user's private chat.
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://YOUR_RAILWAY_DOMAIN/api/v2/telegram/webhook
